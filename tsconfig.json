{
  "compilerOptions": {
    "module": "esnext",
    "moduleResolution": "Node",
    "esModuleInterop": true,
    "strict": true,
    "jsx": "react",
    "noUnusedLocals": true,
    "jsxFactory": "h",
    "target": "es2015",
    "typeRoots": ["./node_modules/@types", "./src/types"],
    "skipLibCheck": true
  },
  "include": [
    "src/**/*"
  ]
}
